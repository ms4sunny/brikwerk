---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Hero from '../components/sections/Hero';
import WorkGrid from '../components/sections/WorkGrid';
import CaseStudies from '../components/work/CaseStudies';
import TechStackWidget from '../components/sections/TechStackWidget';

/* Core studio sections */
import { Services } from '../components/sections/Services';
import Footer from '../components/layout/Footer';

/* Interactive Calculator / Intake Widget */
import ProjectEstimator from '../components/calculator/ProjectEstimator';

const title = 'Brikwerk — Scalable Software Engineering for Ambitious Teams';
const description =
  'Brikwerk is a high-performance software engineering studio building scalable, production-grade digital products for B2B teams — architecture, web engineering, and design that drive growth.';
---

<BaseLayout title={title} description={description}>
  {/* Header Slot */}
  <Fragment slot="header">
    <Navbar client:load />
  </Fragment>

  {/* Main Page Content */}
  <main>
    <Hero client:load />
    
    <TechStackWidget client:visible />
    
    <Services client:visible />
    
    <WorkGrid client:visible />

    {/* Featured Case Studies Section */}
    <CaseStudies client:visible />

    {/* Project Scope & Budget Estimator Section */}
    <section id="estimator" class="py-12 bg-slate-950 relative border-t border-white/5">
      <ProjectEstimator client:visible />
    </section>
  </main>

  {/* Footer */}
  <Footer client:visible />
</BaseLayout>