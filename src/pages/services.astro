---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
---

<BaseLayout title="Services & Capabilities | Brikwerk Engineering">
  <Navbar client:load />
  <main class="min-h-screen pt-32 pb-20 px-6 max-w-7xl mx-auto">
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        Technical Capabilities
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white">
        Architectural Engineering & Advisory
      </h1>
      <p class="text-lg text-neutral-400">
        High-performance frontend systems, scalable backend infrastructure, and comprehensive codebase audits.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-8 rounded-2xl bg-neutral-900/50 border border-neutral-800 backdrop-blur-md">
        <h3 class="text-xl font-semibold text-white mb-2">Frontend Systems</h3>
        <p class="text-sm text-neutral-400">Astro 5, Next.js, Framer Motion, and Tailwind v4 systems built for sub-second page loads.</p>
      </div>
      <div class="p-8 rounded-2xl bg-neutral-900/50 border border-neutral-800 backdrop-blur-md">
        <h3 class="text-xl font-semibold text-white mb-2">Backend & APIs</h3>
        <p class="text-sm text-neutral-400">Serverless API architectures, Database design, and robust integration pipelines.</p>
      </div>
      <div class="p-8 rounded-2xl bg-neutral-900/50 border border-neutral-800 backdrop-blur-md">
        <h3 class="text-xl font-semibold text-white mb-2">System Audits</h3>
        <p class="text-sm text-neutral-400">Performance optimization, TypeScript type safety refactoring, and security reviews.</p>
      </div>
    </div>
  </main>
  <Footer client:load />
</BaseLayout>