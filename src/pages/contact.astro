---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectContactForm from '../components/sections/DirectContactForm';
import ProjectEstimator from '../components/calculator/ProjectEstimator';
---

<BaseLayout title="Contact & Project Intake | Brikwerk Engineering">
  <main class="min-h-screen pt-32 pb-20 px-6 max-w-7xl mx-auto space-y-16">
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
        Studio Communications
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white">
        Start a Conversation
      </h1>
      <p class="text-lg text-neutral-400">
        Choose between sending a quick direct message or running an interactive scope and budget calculation.
      </p>
    </div>

    <!-- Dual Intake System -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start" id="direct-contact">
      <div>
        <DirectContactForm client:load />
      </div>
      <div>
        <ProjectEstimator client:load />
      </div>
    </div>
  </main>
</BaseLayout>