---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
---

<BaseLayout title="Engineering Solutions | Brikwerk Engineering">
  <Navbar client:load />
  <main class="min-h-screen pt-32 pb-20 px-6 max-w-7xl mx-auto">
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        Architecture Solutions
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white">
        Custom Software Architectures
      </h1>
      <p class="text-lg text-neutral-400">
        Tailored technical solutions engineered for high scalability, security, and performance.
      </p>
    </div>
  </main>
  <Footer client:load />
</BaseLayout>