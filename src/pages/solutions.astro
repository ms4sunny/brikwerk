---
import BaseLayout from '../layouts/BaseLayout.astro';

const solutionPillars = [
  {
    badge: 'For Content Creators & Media',
    title: 'Interactive & Social-First Web Apps',
    problem: 'Standard templates fail to hold user attention in an era dominated by rapid social media consumption.',
    solution: 'We engineer custom interactive experiences—featuring touch-compatible cursor engines, custom audio players, and micro-animations—that drive real engagement.',
    impacts: [
      'Increased average session duration',
      'Memorable brand aesthetics that stand out on social media',
      'Smooth desktop and mobile web experiences'
    ],
    relevantProjects: [
      { name: 'Noirwave', link: 'https://noirwave.netlify.app' },
      { name: 'Focussound', link: 'https://focussound.netlify.app' }
    ]
  },
  {
    badge: 'For Startups & Web Founders',
    title: 'Rapid Production-Grade Platform Launches',
    problem: 'Building an MVP often results in sloppy code, poor mobile support, or slow load times that hurt early conversion.',
    solution: 'We build production-ready platforms using Astro, React, and TypeScript from day one—giving you sub-second page loads and clean, scalable codebases.',
    impacts: [
      'Sub-second page load times (95+ Lighthouse targets)',
      'Clean offline roadmap and type-safe architecture',
      'Deployment automation on Vercel or Netlify'
    ],
    relevantProjects: [
      { name: 'Questify', link: 'https://questify-habit.netlify.app' },
      { name: 'DevMarkdown', link: 'https://devmarkdown.netlify.app' }
    ]
  },
  {
    badge: 'For Designers & Agencies',
    title: 'Design Utility & Interactive Studio Engines',
    problem: 'Off-the-shelf design utilities can be slow, clunky, or behind expensive paywalls.',
    solution: 'We build lightweight, client-side web tools that handle real-time color blending, canvas manipulation, and code exports instantly.',
    impacts: [
      'Zero latency client-side execution with local storage persistence',
      'Responsive design across 100% of viewports',
      'Distraction-free, dark-mode first UI'
    ],
    relevantProjects: [
      { name: 'ColorLab', link: 'https://colorlabmix.netlify.app' }
    ]
  }
];

const workflowSteps = [
  {
    step: '01',
    name: 'Discovery & Brief',
    desc: 'We analyze your core problem, define project scope, and set clear performance benchmarks.'
  },
  {
    step: '02',
    name: 'Architecture & UI Build',
    desc: 'High-speed frontend implementation using modern web standards, strict types, and responsive layouts.'
  },
  {
    step: '03',
    name: 'Hardening & Deployment',
    desc: 'Lighthouse audits, SEO verification, and automated deployment pipelines to live hosting.'
  }
];
---

<BaseLayout 
  title="Solutions — Brikwerk"
  description="Tailored web engineering solutions for interactive platforms, rapid startup launches, and custom design utilities."
>
  <div class="py-12 sm:py-20">
    
    <!-- Hero Header -->
    <section class="text-center max-w-4xl mx-auto px-4 mb-20">
      <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-4 py-1.5 text-xs font-mono font-medium text-cyan-400 mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        Targeted Outcomes
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white mb-6 leading-tight">
        Purpose-Built Solutions <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-linear-to-r from-cyan-400 via-teal-300 to-indigo-400">
          for Real Web Problems.
        </span>
      </h1>
      
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
        Whether you need an interactive platform to engage social audiences or a high-speed web utility, we engineer solutions around your specific objectives.
      </p>
    </section>

    <!-- Solutions Pillars -->
    <section class="max-w-7xl mx-auto px-4 mb-24 space-y-12">
      {solutionPillars.map((item) => (
        <div class="relative overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/60 p-8 sm:p-12 backdrop-blur-md">
          
          <span class="inline-block rounded-full bg-cyan-500/10 border border-cyan-500/30 px-3 py-1 text-xs font-mono text-cyan-400 mb-4">
            {item.badge}
          </span>

          <h2 class="text-2xl sm:text-3xl font-extrabold text-white mb-6">
            {item.title}
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <!-- The Challenge -->
            <div class="rounded-2xl border border-slate-800/80 bg-slate-950/60 p-6">
              <h3 class="text-xs font-mono text-rose-400 uppercase tracking-wider mb-2">The Challenge</h3>
              <p class="text-sm text-slate-300 leading-relaxed">{item.problem}</p>
            </div>

            <!-- Brikwerk Solution -->
            <div class="rounded-2xl border border-cyan-500/20 bg-slate-950/60 p-6">
              <h3 class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-2">Brikwerk Solution</h3>
              <p class="text-sm text-slate-300 leading-relaxed">{item.solution}</p>
            </div>
          </div>

          <!-- Key Deliverable Impacts -->
          <div class="border-t border-slate-800/80 pt-6">
            <h3 class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-4">Core Deliverable Impacts</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
              {item.impacts.map((impact) => (
                <li class="flex items-start gap-2 text-xs text-slate-300">
                  <svg class="h-4 w-4 text-cyan-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{impact}</span>
                </li>
              ))}
            </ul>

            <!-- Proof of Concept Links -->
            <div class="flex items-center gap-2 pt-4 border-t border-slate-800/40">
              <span class="text-xs font-mono text-slate-500">Live Proofs:</span>
              <div class="flex flex-wrap gap-2">
                {item.relevantProjects.map((p) => (
                  <a 
                    href={p.link} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="rounded-md border border-slate-800 bg-slate-900 px-2.5 py-1 text-xs font-mono text-cyan-400 hover:border-cyan-500/40 transition-colors"
                  >
                    {p.name} &rarr;
                  </a>
                ))}
              </div>
            </div>
          </div>

        </div>
      ))}
    </section>

    <!-- Execution Workflow -->
    <section class="max-w-7xl mx-auto px-4 mb-24">
      <div class="mb-12 border-b border-slate-800 pb-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">How We Deliver</h2>
        <p class="text-slate-400 text-sm mt-1">Our execution process from brief to live deployment.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {workflowSteps.map((step) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-8">
            <span class="text-3xl font-mono font-black text-cyan-500/80 block mb-3">{step.step}</span>
            <h3 class="text-xl font-bold text-white mb-2">{step.name}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="max-w-4xl mx-auto px-4 text-center">
      <div class="rounded-3xl border border-slate-800 bg-linear-to-b from-slate-900/80 to-slate-950 p-8 sm:p-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">
          Need a solution tailored to your build?
        </h2>
        <p class="text-slate-400 text-sm mb-6 max-w-lg mx-auto">
          Tell us about your project goals and we'll map out a custom technical roadmap.
        </p>
        <a 
          href="/contact" 
          class="inline-flex items-center gap-2 rounded-xl bg-cyan-500 px-6 py-3 text-sm font-bold text-slate-950 hover:bg-cyan-400 transition-all duration-200"
        >
          Start a Solution Inquiry &rarr;
        </a>
      </div>
    </section>

  </div>
</BaseLayout>