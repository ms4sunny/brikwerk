---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar';
import Footer from '../components/layout/Footer';
---

<BaseLayout title="Studio Standards & Philosophy | Brikwerk Engineering">
  <Navbar client:load />
  <main class="min-h-screen pt-32 pb-20 px-6 max-w-7xl mx-auto">
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400 animate-pulse"></span>
        Engineering Standards
      </div>
      <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-white">
        Quality over MVP Shortcuts
      </h1>
      <p class="text-lg text-neutral-400">
        We treat software engineering as structural engineering. Precision typing, strict component boundaries, and zero filler code.
      </p>
    </div>
  </main>
  <Footer client:load />
</BaseLayout>