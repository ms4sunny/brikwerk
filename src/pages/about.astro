---
import BaseLayout from '../layouts/BaseLayout.astro';

const coreValues = [
  {
    number: '01',
    title: 'Performance-First Architecture',
    description: 'We don\'t compromise on speed. Sub-second initial paint, optimized bundle sizes, and zero unnecessary script bloat are baseline requirements for every build.'
  },
  {
    number: '02',
    title: 'Consumer-Centric Experience',
    description: 'Modern web users expect fluid, engaging interfaces. We craft high-touch visual details—custom motion, audio engines, and micro-interactions—that capture attention.'
  },
  {
    number: '03',
    title: 'Strict Type Safety & Clean Code',
    description: 'Maintainable digital products start with solid foundation engineering. We write clean, modular, and type-safe code bases built to scale.'
  },
  {
    number: '04',
    title: 'Transparent Execution',
    description: 'No opaque agency black boxes. Direct communication, predictable roadmaps, and full source code ownership from day one.'
  }
];

const techStack = [
  { category: 'Frontend Frameworks', items: ['Astro', 'React', 'TypeScript', 'Tailwind CSS v4'] },
  { category: 'Animation & Audio', items: ['Canvas API', 'Framer Motion', 'Web Audio API', 'CSS Keyframes'] },
  { category: 'Backend & Hosting', items: ['Node.js', 'Vercel', 'Netlify', 'Serverless Functions'] },
  { category: 'Tooling & CI/CD', items: ['Git / GitHub', 'VS Code', 'Lighthouse Audits', 'ESLint / Prettier'] }
];
---

<BaseLayout 
  title="About Brikwerk — Engineering & Philosophy"
  description="Learn about Brikwerk's web engineering principles, tech stack matrix, and digital product philosophy."
>
  <div class="py-12 sm:py-20">
    
    <!-- Hero Header -->
    <section class="text-center max-w-4xl mx-auto px-4 mb-20">
      <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-4 py-1.5 text-xs font-mono font-medium text-cyan-400 mb-6">
        <span class="h-1.5 w-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        The Brikwerk Blueprint
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white mb-6 leading-tight">
        Structural Precision. <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-linear-to-r from-cyan-400 via-teal-300 to-indigo-400">
          Uncompromised Execution.
        </span>
      </h1>
      
      <p class="text-slate-400 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
        Brikwerk is a independent web engineering brand dedicated to building fast, expressive, and reliable digital applications for modern consumers.
      </p>
    </section>

    <!-- Narrative Section -->
    <section class="max-w-5xl mx-auto px-4 mb-24">
      <div class="rounded-3xl border border-slate-800 bg-slate-900/60 p-8 sm:p-12 backdrop-blur-md">
        <h2 class="text-xs font-mono text-cyan-400 uppercase tracking-widest mb-4">Origin & Intent</h2>
        <h3 class="text-2xl sm:text-3xl font-extrabold text-white mb-6">
          Building platforms that bridge high utility with memorable user experience.
        </h3>
        <div class="space-y-4 text-slate-300 text-sm sm:text-base leading-relaxed">
          <p>
            The web has become bloated with generic templates and heavy JS frameworks that prioritize developer convenience over user experience. Brikwerk was founded on a different premise: that software should feel instant, deliberate, and visually distinct.
          </p>
          <p>
            From interactive web tools and audio utilities to full-scale agency platforms, our focus remains on structural excellence—combining lightweight static rendering with interactive, hardware-accelerated user interfaces.
          </p>
        </div>
      </div>
    </section>

    <!-- Core Values -->
    <section class="max-w-7xl mx-auto px-4 mb-24">
      <div class="mb-12 border-b border-slate-800 pb-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Engineering Principles</h2>
        <p class="text-slate-400 text-sm mt-1">The standards that guide every line of code we ship.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {coreValues.map((val) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/40 p-8 hover:border-cyan-500/30 transition-colors">
            <span class="text-2xl font-mono font-bold text-cyan-400/80 block mb-3">{val.number}</span>
            <h3 class="text-xl font-bold text-white mb-3">{val.title}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">{val.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Tech Matrix -->
    <section class="max-w-7xl mx-auto px-4 mb-24">
      <div class="mb-12 border-b border-slate-800 pb-6">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Technical Stack Matrix</h2>
        <p class="text-slate-400 text-sm mt-1">The tools and engines powering Brikwerk builds.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {techStack.map((stack) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-6">
            <h3 class="text-xs font-mono text-cyan-400 uppercase tracking-wider mb-4">{stack.category}</h3>
            <ul class="space-y-2.5">
              {stack.items.map((item) => (
                <li class="flex items-center gap-2 text-sm text-slate-300">
                  <span class="h-1.5 w-1.5 rounded-full bg-cyan-400"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="max-w-4xl mx-auto px-4 text-center">
      <div class="rounded-3xl border border-slate-800 bg-linear-to-b from-slate-900/80 to-slate-950 p-8 sm:p-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">
          Ready to bring your project to life?
        </h2>
        <p class="text-slate-400 text-sm mb-6 max-w-lg mx-auto">
          Explore our capabilities or reach out directly to discuss your build requirements.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a 
            href="/services" 
            class="inline-flex items-center gap-2 rounded-xl bg-slate-800 border border-slate-700 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-700 hover:border-cyan-500/50 transition-all duration-200"
          >
            View Services
          </a>
          <a 
            href="/contact" 
            class="inline-flex items-center gap-2 rounded-xl bg-cyan-500 px-6 py-3 text-sm font-bold text-slate-950 hover:bg-cyan-400 transition-all duration-200"
          >
            Get in Touch &rarr;
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>